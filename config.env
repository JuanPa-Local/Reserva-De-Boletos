# config.env - Configuracion de red y parametros del SRB
# Leido por los scripts bash (demo.sh, lanzar_clientes.sh, estado.sh, etc.)

IP_CLIENTES=10.43.99.220
IP_GT=10.43.100.37
IP_RMC=10.43.100.38
IP_CANCELACION=10.43.100.38      # misma maquina que el RMC
IP_PERSISTENCIA=10.43.99.215

PUERTO_GT=5555
PUERTO_RMC=5556
PUERTO_CANCELACION=5557
PUERTO_PERSISTENCIA=5558
PUERTO_POSTGRES=5434             # mapeado desde el contenedor Docker
PUERTO_NOTIF_BASE=6001           # cada cliente usa BASE + su numero

# Credenciales y contenedor de Base de Datos
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=srb
CONTAINER_POSTGRES=srb_postgres

# --- Manifiesto de réplicas (M2) ---
REPLICAS_RMC=3
REPLICAS_CANCELACION=2
PASO_REPLICA=10      # RMC: 5556,5566,5576 | Cancelación: 5557,5567

# --- Réplica de lectura de PostgreSQL (M3) ---
PUERTO_POSTGRES_REPLICA=5435        # comenta esta línea para trabajar sin réplica
IP_POSTGRES_REPLICA=10.43.99.215    # M3, o la máquina donde pongas la réplica
REPL_PASSWORD=replica
CONTAINER_POSTGRES_REPLICA=srb_postgres_replica
